[run]
source = src/ulpp
# 只在开发机上跑；运行时依赖仍然只有 pdfplumber / pypdf / Pillow。
# 用法：python3 -m coverage run --rcfile=.coveragerc -m unittest discover -s tests -t .
# 或：  python3 scripts/run_coverage.py

[report]
show_missing = True
skip_covered = False
exclude_lines =
    pragma: no cover
    if __name__ == .__main__.:
    raise NotImplementedError
    if TYPE_CHECKING:
